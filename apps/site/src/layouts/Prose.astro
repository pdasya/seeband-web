---
// A page of text with formulas, such as an MDX page: KaTeX's styles come only with it.
import "katex/dist/katex.min.css";

import Base from "./Base.astro";

interface PageProps {
  title: string;
  description: string;
  /** The header link this page is, if any. */
  current?: "conventions";
}
// An MDX page that names this layout passes its frontmatter; an Astro page passes the props.
type Props = PageProps | { frontmatter: PageProps };

const { title, description, current } =
  "frontmatter" in Astro.props ? Astro.props.frontmatter : Astro.props;
---

<Base title={title} description={description} current={current}>
  <article class="prose">
    <slot />
  </article>
</Base>

<style is:global>
  .prose h2 {
    margin: 40px 0 12px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .prose code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--muted);
    font-family: var(--font-family-mono);
    font-size: 0.875em;
  }

  /* A wide table or a long formula scrolls in its own box, not the page. */
  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 14px;
  }

  .prose th,
  .prose td {
    padding: 8px 12px;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    background: var(--muted);
    font-weight: 600;
  }

  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
  }
</style>
