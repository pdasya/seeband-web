---
// Every page: the shared tokens, fonts and header, and a footer.
import "@seeband/ui/tokens.css";
import "@seeband/ui/fonts.css";
import "@seeband/ui/header.css";
import "../styles/site.css";

import SiteHeader from "@seeband/ui/SiteHeader.astro";

import Footer from "../components/Footer.astro";
import {
  APP_FIT_URL,
  APP_RESULTS_URL,
  CONVENTIONS_URL,
  GUIDE_URL,
  LANGUAGE,
  LOCALE,
  STRINGS,
} from "../strings";

interface Props {
  title: string;
  description: string;
  /** The header link this page is, if any. */
  current?: "overview" | "conventions" | "guide";
  /** Keeps the page out of search even on a public build, as for the 404 page. */
  noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
// Absolute addresses need the public site address, which a build for a closed host lacks.
const canonical =
  Astro.site === undefined
    ? undefined
    : new URL(Astro.url.pathname, Astro.site).href;
const indexable = canonical !== undefined && !noindex;
const links = [
  {
    id: "overview",
    label: STRINGS.navigation.overview,
    href: "/",
    current: current === "overview",
  },
  { id: "fit", label: STRINGS.navigation.fit, href: APP_FIT_URL },
  {
    id: "results",
    label: STRINGS.navigation.results,
    href: APP_RESULTS_URL,
  },
  {
    id: "conventions",
    label: STRINGS.navigation.conventions,
    href: CONVENTIONS_URL,
    current: current === "conventions",
  },
  {
    id: "guide",
    label: STRINGS.navigation.guide,
    href: GUIDE_URL,
    current: current === "guide",
  },
];
---

<!doctype html>
<html lang={LANGUAGE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    {indexable && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={STRINGS.siteName} />
    <meta property="og:locale" content={LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{STRINGS.skipToContent}</a>
    <SiteHeader
      name={STRINGS.siteName}
      homeLabel={STRINGS.homeLabel}
      stage={STRINGS.stage}
      navigationLabel={STRINGS.navigationLabel}
      links={links}
    />
    <main id="content" class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>
