---
import BandFigure from "../components/BandFigure.astro";
import Base from "../layouts/Base.astro";
import {
  APP_DEMO_URL,
  APP_FIT_URL,
  CONVENTIONS_URL,
  ORIGINAL_URL,
  RESULTS_CHANGED_URL,
  STRINGS,
} from "../strings";
import { subscripts } from "../subscripts";

const text = STRINGS.home;
const app = STRINGS.application;
// schema.org's description of the app, for search engines. Its address only on a public build.
const application = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: app.name,
  description: text.description,
  ...(Astro.site === undefined ? {} : { url: new URL("/", Astro.site).href }),
  applicationCategory: app.category,
  operatingSystem: app.operatingSystem,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  license: app.licence,
  isBasedOn: ORIGINAL_URL,
};
---

<Base title={text.title} description={text.description} current="overview">
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(application)}
  />
  <div class="overview">
    <section class="hero">
      <div class="hero__text">
        <span class="eyebrow">{text.eyebrow}</span>
        <h1>{text.heading}</h1>
        <p class="lead" set:html={subscripts(text.lead)} />
        <div class="actions">
          <a class="button" href={APP_FIT_URL}>{text.startFit}</a>
          <a class="button button--outline" href={CONVENTIONS_URL}>
            {text.readConventions}
          </a>
        </div>
        <p class="note">{text.ctaNote}</p>
      </div>
      <BandFigure />
    </section>

    <section aria-labelledby="how">
      <h2 id="how">{text.how.title}</h2>
      <ol class="steps" role="list">
        {
          text.how.steps.map((step, index) => (
            <li class="step">
              <span class="step__number">{`0${String(index + 1)}`}</span>
              <span class="step__title">{step.title}</span>
              <span class="step__text" set:html={subscripts(step.text)} />
            </li>
          ))
        }
      </ol>
    </section>

    <div class="panels">
      <section class="panel panel--wide" aria-labelledby="inputs">
        <h2 id="inputs">{text.inputs.title}</h2>
        <div class="table-scroll" tabindex="0" role="region" aria-labelledby="inputs">
          <table class="inputs">
            <thead>
              <tr>
                <th scope="col">{text.inputs.quantity}</th>
                <th scope="col">{text.inputs.unit}</th>
                <th scope="col">{text.inputs.determines}</th>
              </tr>
            </thead>
            <tbody>
              {
                text.inputs.rows.map((row) => (
                  <tr>
                    <th scope="row" set:html={subscripts(row.quantity)} />
                    <td class="mono">{row.unit}</td>
                    <td set:html={subscripts(row.determines)} />
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        {text.inputs.notes.map((note) => <p class="note" set:html={subscripts(note)} />)}
      </section>
      <section class="panel" aria-labelledby="outputs">
        <h2 id="outputs">{text.outputs.title}</h2>
        <ul class="outputs">
          {text.outputs.items.map((item) => <li set:html={subscripts(item)} />)}
        </ul>
      </section>
    </div>

    <div class="panels">
      <section class="panel" aria-labelledby="data">
        <h2 id="data">{text.data.title}</h2>
        <p>{text.data.text}</p>
      </section>
      <section class="panel" aria-labelledby="status">
        <h2 id="status">{text.status.title}</h2>
        <p>{text.status.text}</p>
        <p><a href={RESULTS_CHANGED_URL}>{text.status.changed}</a></p>
      </section>
    </div>

    <section class="demo" aria-labelledby="demo">
      <div>
        <h2 id="demo">{text.demo.title}</h2>
        <p>{text.demo.text}</p>
      </div>
      <a class="button" href={APP_DEMO_URL}>{text.demo.action}</a>
    </section>
  </div>
</Base>
