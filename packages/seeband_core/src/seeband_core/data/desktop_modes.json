  "deviations": [
    {
      "id": "D1",
      "title": "DPB S + rho + R_H with dis passes G bounds in slider units",
      "desktop": "Start is 1.0 (slider / 100), bounds stay 50 to 200, so `curve_fit` rejects the start as infeasible. In S + rho the bounds are scaled.",
      "web": "Use bounds 0.5 to 2. This is a deliberate deviation in the GUI layer. C3 confirms the failure end to end.",
      "resolved_by": "#11 (C3)",
      "source": [
        "seeband.py:5047",
        "seeband.py:5048",
        "seeband.py:5006",
        "seeband.py:5007"
      ]
    },
    {
      "id": "D2",
      "title": "SPB S + rho + R_H always fails",
      "desktop": "The fit reads `fermi_slider_spb`, which does not exist, so the thread stops with an error.",
      "web": "Mode disabled until fixed.",
      "resolved_by": "#83 (P4)",
      "source": ["seeband.py:4926"]
    },
    {
      "id": "D3",
      "title": "SPB S + rho + R_H builds the initial mass parameter incorrectly",
      "desktop": "The slider value is passed without dividing by 100, with raw slider bounds. For m > 0 the expression gives an empty list.",
      "web": "Fixed with the mode.",
      "resolved_by": "#83 (P4)",
      "source": [
        "seeband.py:4930",
        "seeband.py:4931",
        "modules/fit_module.py:592"
      ]
    },
    {
      "id": "D4",
      "title": "SPB C has three different scales",
      "desktop": "Displayed as slider / 100, but the fit and the S + rho curve use the raw slider value, then multiply by 300 for acPhDis.",
      "web": "Exact port keeps the numbers. Describe C in core units and flag acPhDis results.",
      "resolved_by": "#82 (P3)",
      "source": [
        "seeband.py:3513",
        "seeband.py:4892",
        "seeband.py:3526",
        "modules/fit_module.py:204",
        "modules/fit_module.py:1483"
      ]
    },
    {
      "id": "D5",
      "title": "SPB S + rho + R_H curve multiplies C by 300 twice",
      "desktop": "The handler passes slider * 300, and the calculation multiplies by 300 again for acPhDis. S + rho passes the raw value.",
      "web": "Fixed with the mode.",
      "resolved_by": "#83 (P4)",
      "source": [
        "seeband.py:3558",
        "seeband.py:3526",
        "modules/fit_module.py:1617"
      ]
    },
    {
      "id": "D6",
      "title": "SPB S + rho + R_H returns B without dividing by 300",
      "desktop": "S + rho divides by 300 on return and S + rho + R_H does not, while the calculation multiplies by 300 again.",
      "web": "Fixed with the mode.",
      "resolved_by": "#83 (P4)",
      "source": ["modules/fit_module.py:702", "modules/fit_module.py:265"]
    },
    {
      "id": "D7",
      "title": "SPB S + rho + R_H result curve passes too few parameters",
      "desktop": "The curve after a fit passes `params[1:3]`, and S + rho passes `params[1:4]`. With dis, both values are removed and the calculation has no parameter left.",
      "web": "Fixed with the mode.",
      "resolved_by": "#83 (P4)",
      "source": [
        "seeband.py:4938",
        "seeband.py:4901",
        "modules/fit_module.py:1614"
      ]
    },
    {
      "id": "D8",
      "title": "Iteration settings differ between DPB modes",
      "desktop": "S + rho hardcodes 0.1 and 1000. S + rho + R_H uses 0.1 and 20 from the main window. Neither can be changed in a window.",
      "web": "Exact port keeps these per-mode values in the model description.",
      "resolved_by": "#16 (C8)",
      "source": [
        "seeband.py:5013",
        "seeband.py:5055",
        "seeband.py:43",
        "seeband.py:44"
      ]
    },
    {
      "id": "D9",
      "title": "Advanced options for SPB parameter A write to DPB variables",
      "desktop": "The SPB S + rho handler sets `para_A_*_limit_dpb_res`, and the S + rho + R_H handler also changes `para_A_slider_dpb_hall`. Limits entered for SPB A never reach an SPB fit.",
      "web": "Not ported. Editable bounds apply to the selected mode.",
      "resolved_by": "#57 (FS13)",
      "source": [
        "seeband.py:4477",
        "seeband.py:4478",
        "seeband.py:4491",
        "seeband.py:4492",
        "seeband.py:4893"
      ]
    },
    {
      "id": "D10",
      "title": "DPB limit variables are not used by fits",
      "desktop": "`para_*_limit_dpb_*` are initialised and edited, but DPB fits read slider ranges. SPB `para_E_*_limit_spb_hall` is not read at all.",
      "web": "Not ported. `fit_bounds` here records what the fits actually use.",
      "resolved_by": "#57 (FS13)",
      "source": [
        "seeband.py:1798",
        "seeband.py:2310",
        "seeband.py:5006",
        "seeband.py:5048",
        "seeband.py:1142"
      ]
    },
    {
      "id": "D11",
      "title": "Defaults and steps differ between windows of the same model",
      "desktop": "SPB mass and E_F start at 1.01 and 100 in S, -1.00 and -100 in S + rho, 1.00 and 100 in S + rho + R_H. The G step is 1 in S + rho and 100 in S + rho + R_H.",
