{
  "openapi": "3.1.0",
  "info": {
    "title": "SeeBand API",
    "version": "0.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "internal_error": {
                    "value": {
                      "code": "internal_error",
                      "message": "Internal server error",
                      "details": []
                    }
                  },
                  "not_found": {
                    "value": {
                      "code": "not_found",
                      "message": "Not Found",
                      "details": []
                    }
                  },
                  "validation_error": {
                    "value": {
                      "code": "validation_error",
                      "message": "Invalid request",
                      "details": [
                        {
                          "location": [
                            "body",
                            "seebeck_v_per_k",
                            3
                          ],
                          "code": "float_parsing",
                          "message": "Input should be a valid number, unable to parse string as a number"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "location": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "location",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "description": "One problem in a request. `location` is the path to it, such as `[\"body\", \"points\", 3]`."
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorResponse",
        "description": "The body of every error response."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "examples": [
          {
            "status": "ok",
            "version": "1.0.0"
          }
        ]
      }
    }
  }
}
