# Copy to deploy/.env and adjust. deploy/.env stays out of the repository; keep secrets there.

# --- Compose (also read from the shell) ---
# What Caddy serves: :80 for plain HTTP, or the domain on a real host, which then gets HTTPS.
SEEBAND_SITE_ADDRESS=:80
# Host ports; 80 and 443 on a real host.
SEEBAND_HTTP_PORT=8080
SEEBAND_HTTPS_PORT=8443
# The public address the site is built for. Leave empty on the prototype host, so that every
# page stays out of search engines until the move to the final host (I6).
SEEBAND_SITE_URL=
# The commit the images name, as `git rev-parse HEAD` gives it.
SEEBAND_COMMIT=
# Image names and tag, as the registry holds them (I2).
SEEBAND_IMAGE_PREFIX=seeband
SEEBAND_TAG=local

# --- API (SEEBAND_API_*, see apps/api/src/seeband_api/settings.py) ---
# Size the processes to the machine's vCPUs: calculation workers plus running fits should not
# exceed them by much. The defaults (2 workers, 2 fits) are for 2 vCPUs; measure on the machine
# before changing them (I3).
# SEEBAND_API_CALC_WORKERS=2
# SEEBAND_API_FIT_MAX_RUNNING=2
# SEEBAND_API_LOG_LEVEL=INFO
